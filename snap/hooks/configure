#!/bin/bash -eu
# https://snapcraft.io/docs/supported-snap-hooks

# Read configuration and restart service if changed
URL=$(snapctl get url 2>/dev/null || echo "")
FLAGS=$(snapctl get flags 2>/dev/null || echo "")
DEBUG=$(snapctl get debug 2>/dev/null || echo "")

if [ -n "${URL}" ]; then
    snapctl set url="${URL}"
fi

if [ -n "${FLAGS}" ]; then
    snapctl set flags="${FLAGS}"
fi

if [ -n "${DEBUG}" ]; then
    snapctl set debug="${DEBUG}"
fi

# Restart the daemon to apply new configuration
snapctl restart "${SNAP_INSTANCE_NAME}.daemon"