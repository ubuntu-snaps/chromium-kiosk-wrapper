#!/bin/bash -eu

# Chromium Kiosk Launcher
# This script launches Chromium in kiosk mode for Ubuntu Core

set -e

# Configuration - can be overridden via snap set
URL="${URL:-$(snapctl get url 2>/dev/null || echo http://localhost)}"
FLAGS="${FLAGS:-$(snapctl get flags 2>/dev/null || echo "")}"
DEBUG="${DEBUG:-$(snapctl get debug 2>/dev/null || echo false)}"
USER_DATA_DIR="${SNAP_DATA}/chromium-profile"
EXTENSIONS_DIR="${SNAP}/extensions"

# Ensure user data directory exists
mkdir -p "${USER_DATA_DIR}"

# Wayland setup
export WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-0}"
export XDG_RUNTIME_DIR="${SNAP_DATA}/wayland"
mkdir -p "${XDG_RUNTIME_DIR}"

# Chromium binary from stage-snaps
CHROMIUM_BIN="${SNAP}/usr/lib/chromium-browser/chrome"

# Build chromium command
CHROMIUM_CMD=(
    "${CHROMIUM_BIN}"
    --kiosk
    --no-first-run
    --no-default-browser-check
    --disable-infobars
    --disable-session-crashed-bubble
    --disable-component-update
    --disable-background-networking
    --disable-background-timer-throttling
    --disable-renderer-backgrounding
    --disable-features=TranslateUI
    --disable-ipc-flooding-protection
    --password-store=basic
    --ozone-platform=wayland
    --enable-features=WaylandWindowDecorations
    --user-data-dir="${USER_DATA_DIR}"
    "${URL}"
)

# Add any extra flags from configuration
if [ -n "${FLAGS}" ]; then
    # shellcheck disable=SC2206
    CHROMIUM_CMD+=(${FLAGS})
fi

# Enable remote debugging if debug is true
if [ "${DEBUG}" = "true" ]; then
    CHROMIUM_CMD+=(--remote-debugging-port=9222 --remote-debugging-address=0.0.0.0)
fi

# Load extensions if available
if [ -d "${EXTENSIONS_DIR}" ]; then
    EXTENSION_FILES=()
    for ext in "${EXTENSIONS_DIR}"/*.crx; do
        [ -f "$ext" ] && EXTENSION_FILES+=("$ext")
    done
    if [ ${#EXTENSION_FILES[@]} -gt 0 ]; then
        # Join paths with comma for --load-extension
        IFS=,
        CHROMIUM_CMD+=(--load-extension="${EXTENSION_FILES[*]}")
        unset IFS
        echo "Loading ${#EXTENSION_FILES[@]} extension(s): ${EXTENSION_FILES[*]}"
    fi
fi

echo "Starting Chromium in kiosk mode..."
echo "URL: ${URL}"
echo "User data: ${USER_DATA_DIR}"
echo "Debug: ${DEBUG}"
echo "Command: ${CHROMIUM_CMD[*]}"

exec "${CHROMIUM_CMD[@]}"
